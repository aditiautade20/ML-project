# ==============================================================================
# InvoiceIQ Backend Environment Configuration Template
# Copy this file to .env and adjust variables for your deployment environment.
# ==============================================================================

# Application Environment (development / production)
# In production, set DEBUG=False to disable interactive debug traces.
ENVIRONMENT=development
DEBUG=True

# Network Binding Host & Port
HOST=127.0.0.1
PORT=8000

# Security / JWT Configuration
# MANDATORY: Generate a strong random 256-bit secret in production:
# Windows PowerShell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 64 | % {[char]$_})
# Linux/macOS:        openssl rand -hex 32
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Connection URL
# SQLite (Local Development): sqlite:///./data/invoiceiq.db
# PostgreSQL (Production Example): postgresql://user:password@localhost:5432/invoiceiq_db
DATABASE_URL=sqlite:///./data/invoiceiq.db

# File Storage Configuration
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=10

# CORS Allowed Origins
# Comma-separated list of trusted web origins allowed to make API requests.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
